# Initialize the Rich console and install pretty print exception handler
console = Console()
install(show_locals=True)

# --- GraphQL Query Setup ---
base_url = "https://www.booli.se/graphql"
headers = {"Content-Type": "application/json; charset=utf-8"}


def graphql_listings(client: httpx.Client, start_date: str, end_date: str, page: int):
    """
    Query the Booli GraphQL endpoint for listings.
    """
    variables = {
        "queryContext": "SERP_LIST_LISTING",
        "input": {
            "filters": [
                {"key": "maxSoldDate", "value": end_date},
                {"key": "minSoldDate", "value": start_date},
                {"key": "objectType", "value": "Lägenhet"},
            ],
            "areaId": "2",
            "sort": "",
            "page": page,
            "ascending": False,
            "excludeAncestors": True,
            "facets": ["upcomingSale"],
        },
    }
    extensions = {
        "persistedQuery": {
            "version": 1,
            "sha256Hash": "e6afcbda5c671553ce4ac70334362174c136b21eb3cfc1b20104be0b4ea9646c",
        }
    }
    params = {
        "operationName": "search",
        "variables": json.dumps(variables),
        "extensions": json.dumps(extensions),
    }
    response = client.get(base_url, headers=headers, params=params)
    response.raise_for_status()

    if response.status_code == 202:
        console.print(
            f"⏰ HTTP 202 Accepted received for listings query on [cyan]{page}[/cyan], back off and try again",
            style="yellow",
        )
        max_attempts = 10

        for attempt in range(max_attempts):
            time.sleep(120)
            console.print(
                f"📨 Retrying listings query attempt ({attempt+1}/{max_attempts}) on [cyan]{page}[/cyan]...",
                style="blue",
            )
            response = client.get(base_url, headers=headers, params=params)
            response.raise_for_status()
            if response.status_code != 202:
                console.print(
                    f"✓ Successful listings query for [cyan]{page}[/cyan].",
                    style="green",
                )
                return response.json()

        # TODO: Maybe add retry logic here, abort if we reach max attempts
        console.print(
            f"❌ Failed listings query on [cyan]{page}[/cyan].", style="bold red"
        )
        raise httpx.TimeoutException("Timeout during listings query")

    return response.json()


